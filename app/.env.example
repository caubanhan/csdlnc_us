# Copy file này thành app/.env rồi sửa cho máy của bạn. KHÔNG commit file .env.
DB_SERVER=localhost
DB_NAME=FitLifeHub
DB_DRIVER=ODBC Driver 18 for SQL Server

# yes = đăng nhập bằng tài khoản Windows (mặc định khi cài SQL Server trên máy cá nhân)
DB_TRUSTED=yes

# Chỉ điền khi DB_TRUSTED=no (đăng nhập bằng tài khoản SQL, ví dụ sa)
DB_USER=
DB_PASSWORD=
